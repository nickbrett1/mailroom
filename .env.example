# Environment variables for mailroom (docker-container)
# Generated by genproj. Copy to `.env` next to docker-compose.yml and fill in
# real values (genproj never commits secrets).
#
# Keys are derived from the docker-container `envVars` configuration; nothing
# is invented here.

MSGVAULT_URL=
MSGVAULT_TOKEN=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
PSN_CLIENT_ID=
PSN_CLIENT_SECRET=
MAILROOM_DB_URL=sqlite:////data/mailroom.db
DAGSTER_HOME=/data/dagster
# Cover cache dir on the shared data volume (served read-only by pshelf).
MAILROOM_COVERS_DIR=/data/covers

# ntfy push when new games are added to the catalog (memos/game-catalog-notify).
# NTFY_URL defaults to the public https://ntfy.sh; point it at your self-hosted
# NAS instance (e.g. http://ntfy:80) if you self-host ntfy.
NTFY_URL=https://ntfy.sh
NTFY_NEW_GAME_TOPIC=new-game-nickbrett-9831
# Set to "0" to disable new-game notifications entirely.
NTFY_NEW_GAME_ENABLED=1

# Host path for the shared catalog data volume
DATA_DIR=/path/to/mailroom-data
